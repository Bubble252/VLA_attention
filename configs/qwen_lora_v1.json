{
  "schema": "vla-attention/qwen-lora/v1",
  "student": "Qwen2.5-VL-7B-Instruct",
  "precision": "bf16",
  "processor_use_fast": false,
  "vision_encoder": "frozen",
  "peft": {
    "task_type": "CAUSAL_LM",
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules_regex": "^model\\.language_model\\.layers\\.[0-9]+\\.(self_attn\\.(q_proj|k_proj|v_proj|o_proj)|mlp\\.(gate_proj|up_proj|down_proj))$"
  },
  "optimizer": {"name": "AdamW", "learning_rate": 0.0002, "betas": [0.9, 0.95], "eps": 1e-8, "weight_decay": 0.0, "gradient_clip_norm": 1.0},
  "schedule": {"name": "cosine", "warmup_ratio": 0.03},
  "smoke": {"steps": [20, 50], "must_check": ["caption_label_mask", "finite_loss", "finite_gradients", "checkpoint_resume", "gpu_memory", "no_visual_lora_parameters"]}
}
